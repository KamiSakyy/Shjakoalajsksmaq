    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_version">Version %1$s (%2$d)</string>
    <string name="about_tagline">A fully offline EPUB 3 editor for Japanese light novels.</string>
    <string name="about_features_title">Features</string>
    <string name="about_f1">EPUB 3.0.1: OPF 3.0, nav (epub:type=toc), NCX for compatibility</string>
    <string name="about_f2">Vertical writing: writing-mode vertical-rl, page-progression-direction rtl</string>
    <string name="about_f3">Furigana (ruby) with Aozora Bunko rules: 漢字《かんじ》, ｜base《かんじ》</string>
    <string name="about_f4">Import .txt / .md with automatic UTF-8, Shift_JIS and CP1251 detection</string>
    <string name="about_f5">Gallery cover: downscaled to 1600 px and embedded into the EPUB</string>
    <string name="about_f6">Project backup as .json — the cover is embedded as base64</string>
    <string name="about_f7">No network, no account, no ads, no telemetry</string>
    <string name="about_f8">Unit-tested core, built by GitHub Actions</string>
    <string name="about_components">Components: AndroidX, Material Components for Android (Apache-2.0).</string>
