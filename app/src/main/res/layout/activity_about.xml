<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_splash"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/version_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/about_tagline"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp"
            android:gravity="center" />

        <TextView
            style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:text="@string/about_features_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface_container"
            android:padding="14dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/about_f1" android:textColor="@color/text_primary" android:textSize="13sp" android:lineSpacingExtra="3dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="@string/about_f2" android:textColor="@color/text_primary" android:textSize="13sp" android:lineSpacingExtra="3dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="@string/about_f3" android:textColor="@color/text_primary" android:textSize="13sp" android:lineSpacingExtra="3dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="@string/about_f4" android:textColor="@color/text_primary" android:textSize="13sp" android:lineSpacingExtra="3dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="@string/about_f5" android:textColor="@color/text_primary" android:textSize="13sp" android:lineSpacingExtra="3dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="@string/about_f6" android:textColor="@color/text_primary" android:textSize="13sp" android:lineSpacingExtra="3dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="@string/about_f7" android:textColor="@color/text_primary" android:textSize="13sp" android:lineSpacingExtra="3dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="@string/about_f8" android:textColor="@color/text_primary" android:textSize="13sp" android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/about_components"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:gravity="center"
            android:lineSpacingExtra="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/close_about_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="16dp"
            android:text="@string/about_close"
            android:textAllCaps="false"
            style="@style/Widget.Material3.Button.TonalButton" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
